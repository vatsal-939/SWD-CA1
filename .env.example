# MedVault Environment Configuration
# Copy this file to .env and adjust variables as needed

FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production-min-32-chars
DATABASE_PATH=medvault.db

# Security Settings
SESSION_COOKIE_SECURE=False  # Set to True when running under HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
PERMANENT_SESSION_LIFETIME_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
